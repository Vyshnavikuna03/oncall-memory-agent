{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Incident",
  "type": "object",
  "required": ["id", "timestamp", "service", "severity", "symptoms", "root_cause", "fix_applied", "outcome"],
  "properties": {
    "id": { "type": "string", "description": "e.g. INC-1042" },
    "timestamp": { "type": "string", "format": "date-time" },
    "service": { "type": "string", "description": "e.g. payments-api" },
    "severity": { "type": "string", "enum": ["SEV1", "SEV2", "SEV3"] },
    "symptoms": { "type": "string", "description": "What the on-call engineer saw (alerts, user impact)" },
    "logs": { "type": "string", "description": "Representative error log lines" },
    "root_cause": { "type": "string" },
    "fix_applied": { "type": "string" },
    "outcome": { "type": "string", "enum": ["resolved", "failed", "partial"] },
    "time_to_resolve_minutes": { "type": "integer" },
    "engineer": { "type": "string" }
  }
}